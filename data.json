{"seq": {"exam": 1, "leader": 17, "question": 47, "assistant": 1}, "exams": [], "leaders": [{"id": 1, "qq": "2738703541", "name": "CU奶盖组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 2, "qq": "1563472180", "name": "CU落落组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 3, "qq": "3757086745", "name": "CU季眠组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 4, "qq": "2428645352", "name": "CU卿默组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 5, "qq": "3659095409", "name": "CU吻痕组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 6, "qq": "3769628699", "name": "CU初稚组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 7, "qq": "2094569662", "name": "CU小余组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 8, "qq": "2565575374", "name": "CU狐狸组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 9, "qq": "2169235494", "name": "CU清水组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 10, "qq": "3968196062", "name": "CU涵雅组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 11, "qq": "3668689023", "name": "CU零六组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 12, "qq": "3477837329", "name": "CU明珠组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 13, "qq": "2986168141", "name": "CU逍遥组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 14, "qq": "2556773048", "name": "CU幽静组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 15, "qq": "3699627062", "name": "CU星屿组长", "created_at": "2026-11-07T19:52:41.584567Z"}, {"id": 16, "qq": "3877484549", "name": "CU栀夏组长", "created_at": "2026-11-07T19:52:41.584567Z"}], "settings": {"owner_qq": "201005194006", "owner_pwd": "bo05194006"}, "questions": [{"id": 1, "bank": "A", "sort": 1, "stem": "试音群无法进入，正确做法是？", "qtype": "single", "answer": "B", "blanks": 0, "options": ["在接单群直接发问", "添加派单好友，询问该单子是否还有名额", "直接放弃接单", "在群内吐槽"]}, {"id": 2, "bank": "A", "sort": 2, "stem": "老板问单子价格，我如实告诉老板报价，不算违规。", "qtype": "judge", "answer": "错", "blanks": 0, "options": []}, {"id": 3, "bank": "A", "sort": 3, "stem": "进入试音群两种途径：____、____。", "qtype": "fill", "answer": "扫码进入、点群号进入", "blanks": 2, "options": []}, {"id": 4, "bank": "A", "sort": 4, "stem": "接单标注“8半”含义：____。", "qtype": "fill", "answer": "八元半小时", "blanks": 1, "options": []}, {"id": 5, "bank": "A", "sort": 5, "stem": "请写出团内6种不给陪陪结账的情况。", "qtype": "short", "answer": "①技术单输掉且评分倒数第一、第二名；②谎报自身实力；③出现炸单行为；④接单混单、水单；⑤被老板给出差评；⑥不尊重派单、态度恶劣挑事。", "blanks": 0, "options": []}, {"id": 6, "bank": "A", "sort": 6, "stem": "老板赠送礼物、钱款结算规则是什么？", "qtype": "short", "answer": "不可变现礼物（皮肤等）自行收下，需告知派单；钱款赠送：第一次全额归派单，第二次及以后派单3成、陪陪7成。", "blanks": 0, "options": []}, {"id": 7, "bank": "A", "sort": 7, "stem": "区分炸单和混单，并各举一例。", "qtype": "short", "answer": "炸单：被老板选中后拒单、中途退单、同时接多单无法履约。例：被老板选中后临时说接不了单。\n混单：麦质模糊、不听老板安排、敷衍接单。例：全程麦有杂音，自顾自玩不配合老板。", "blanks": 0, "options": []}, {"id": 8, "bank": "B", "sort": 1, "stem": "下列哪一项属于抢老板的违规行为？", "qtype": "single", "answer": "B", "blanks": 0, "options": ["在试音群正常发送试音", "私加、私聊老板", "打完订单提交截图", "服从派单安排"]}, {"id": 9, "bank": "B", "sort": 2, "stem": "单子标注数字7代表什么？", "qtype": "single", "answer": "B", "blanks": 0, "options": ["老板已经选好人，单子结束", "老板没有选到合适陪陪，放弃该单子", "新的单子上架", "单子加价"]}, {"id": 10, "bank": "B", "sort": 3, "stem": "微冒充指冒充派单提供的资料进行接单。", "qtype": "judge", "answer": "对", "blanks": 0, "options": []}, {"id": 11, "bank": "B", "sort": 4, "stem": "接单群里面可以随意打卡、听歌、闲聊。", "qtype": "judge", "answer": "错", "blanks": 0, "options": []}, {"id": 12, "bank": "B", "sort": 5, "stem": "双条指____和____，日常接单一般只用语音条。", "qtype": "fill", "answer": "语音条、文字条", "blanks": 2, "options": []}, {"id": 13, "bank": "B", "sort": 6, "stem": "卡女的含义是：老板只需要____性陪陪接单。", "qtype": "fill", "answer": "女", "blanks": 1, "options": []}, {"id": 14, "bank": "B", "sort": 7, "stem": "语聊哄睡单结束后，需要提交挂电话前____分钟内的时长截图才算有效。", "qtype": "fill", "answer": "两", "blanks": 1, "options": []}, {"id": 15, "bank": "B", "sort": 8, "stem": "遇到别人借钱、换号、提出二次收费，应该怎么处理？", "qtype": "short", "answer": "无论对方是谁，必须直接举报；团内普通小额罚款5元以内，禁止一切私下二次收费，不举报后果自负。", "blanks": 0, "options": []}, {"id": 16, "bank": "B", "sort": 9, "stem": "自退人员和被清理人员在入团权限上有什么区别？打完单子要对老板好友做什么操作？", "qtype": "short", "answer": "自退人员可以二次入团；被清理人员不可二次入团，且必须删除相关好友。所有陪陪打完单子必须删除老板好友。", "blanks": 0, "options": []}, {"id": 17, "bank": "B", "sort": 10, "stem": "游戏单选人前和结束后，技术单、娱乐单分别要提交什么材料？", "qtype": "short", "answer": "选人前：技术单发战绩、主页；娱乐单只需试音。\n结束后：娱乐单发组队截图+收款码；技术单发战绩截图+收款码。", "blanks": 0, "options": []}, {"id": 18, "bank": "C", "sort": 1, "stem": "单子标记 8/3 代表什么？", "qtype": "single", "answer": "B", "blanks": 0, "options": ["3元8局", "8元3局", "8元半小时", "3元8分钟"]}, {"id": 19, "bank": "C", "sort": 2, "stem": "非派单人员不可以在接单群随意发数字1、7或者发布单子。", "qtype": "judge", "answer": "对", "blanks": 0, "options": []}, {"id": 20, "bank": "C", "sort": 3, "stem": "什么是卡设备和微冒充？分别解释说明。", "qtype": "short", "answer": "卡设备：指使用iPad、电脑设备进行接单。\n微冒充：指冒充派单提供的个人资料进行接单，属于违规行为。", "blanks": 0, "options": []}, {"id": 21, "bank": "C", "sort": 4, "stem": "接单群里面禁止哪些行为？至少写出4项。", "qtype": "short", "answer": "禁止互加好友、禁止拍一拍、禁止打卡、禁止听歌、禁止乱发消息、禁止随意艾特他人、禁止非派单发1/7和单子（任选4项即可）", "blanks": 0, "options": []}, {"id": 22, "bank": "C", "sort": 5, "stem": "试音群里数字1和数字7分别代表什么含义？", "qtype": "short", "answer": "数字1：老板已经选完人，单子结束，全员退出试音群。\n数字7：老板未选到合适陪陪、主动放弃单子，全员退出试音群。", "blanks": 0, "options": []}, {"id": 23, "bank": "J", "sort": 1, "stem": "通过考核后找谁拉进接单群？", "qtype": "single", "answer": "B", "blanks": 0, "options": ["随便群内老人", "组长", "派单"]}, {"id": 24, "bank": "J", "sort": 2, "stem": "试音双条指的是语音条和____。", "qtype": "fill", "answer": "文字条", "blanks": 1, "options": []}, {"id": 25, "bank": "J", "sort": 3, "stem": "单子标记数字1代表老板已经选好人，单子结束。", "qtype": "judge", "answer": "对", "blanks": 0, "options": []}, {"id": 26, "bank": "J", "sort": 4, "stem": "标识“8半”是什么意思？", "qtype": "single", "answer": "A", "blanks": 0, "options": ["八块钱半小时", "八元半场", "半价八元"]}, {"id": 27, "bank": "J", "sort": 5, "stem": "试音语音条时长要求：____秒。", "qtype": "fill", "answer": "5–10", "blanks": 1, "options": []}, {"id": 28, "bank": "J", "sort": 6, "stem": "试音群在老板选人结束前可以随意早退。", "qtype": "judge", "answer": "错", "blanks": 0, "options": []}, {"id": 29, "bank": "J", "sort": 7, "stem": "进不去试音群的正确做法？", "qtype": "single", "answer": "B", "blanks": 0, "options": ["在接单群直接提问", "添加派单好友询问", "直接不管"]}, {"id": 30, "bank": "J", "sort": 8, "stem": "接单群内不可以私自给____报单子价格。", "qtype": "fill", "answer": "老板", "blanks": 1, "options": []}, {"id": 31, "bank": "J", "sort": 9, "stem": "打完单子之后需要删除老板好友。", "qtype": "judge", "answer": "对", "blanks": 0, "options": []}, {"id": 32, "bank": "J", "sort": 10, "stem": "“卡女”的含义是？", "qtype": "single", "answer": "A", "blanks": 0, "options": ["单子只要女生", "卡住平板设备", "老板指定老陪陪"]}, {"id": 33, "bank": "J", "sort": 11, "stem": "单子数字标记7代表老板没有选到合适的人，____。", "qtype": "fill", "answer": "放弃单子", "blanks": 1, "options": []}, {"id": 34, "bank": "J", "sort": 12, "stem": "技术单子选人之前需要发送什么？", "qtype": "single", "answer": "A", "blanks": 0, "options": ["战绩、主页", "收款码", "时长截图"]}, {"id": 35, "bank": "J", "sort": 13, "stem": "老板第一次送的礼物钱款，全部归派单。", "qtype": "judge", "answer": "对", "blanks": 0, "options": []}, {"id": 36, "bank": "J", "sort": 14, "stem": "游戏娱乐单子打完之后，需要上交什么？", "qtype": "short", "answer": "组队截图、收款码", "blanks": 0, "options": []}, {"id": 37, "bank": "J", "sort": 15, "stem": "下面哪一项属于炸单？", "qtype": "single", "answer": "A", "blanks": 0, "options": ["被选中之后拒接单子", "按时试音", "上交截图"]}, {"id": 38, "bank": "J", "sort": 16, "stem": "遇到借钱、换号、二次收费，必须立刻____。", "qtype": "fill", "answer": "举报", "blanks": 1, "options": []}, {"id": 39, "bank": "J", "sort": 17, "stem": "对派单态度差、阴阳怪气，单子做完一样结账。", "qtype": "judge", "answer": "错", "blanks": 0, "options": []}, {"id": 40, "bank": "J", "sort": 18, "stem": "试音群里面禁止的行为写出任意两项。", "qtype": "short", "answer": "早退、不改名不试音（也可填卖惨、闲聊，任选两项即可）", "blanks": 0, "options": []}, {"id": 41, "bank": "J", "sort": 19, "stem": "挂电话前任意时间截图，都算作哄睡单子有效时长截图。", "qtype": "judge", "answer": "错", "blanks": 0, "options": []}, {"id": 42, "bank": "J", "sort": 20, "stem": "老板第二次赠送的单子收益分成：派单拿3成，接单拿____成。", "qtype": "fill", "answer": "7", "blanks": 1, "options": []}, {"id": 43, "bank": "J", "sort": 21, "stem": "写出任意两种不会给陪陪结账的情况。", "qtype": "short", "answer": "技术单输且评分倒数一二、谎报实力（炸单/混单/差评/不尊重派单，任选两个）", "blanks": 0, "options": []}, {"id": 44, "bank": "J", "sort": 22, "stem": "“微冒充”指的是？", "qtype": "single", "answer": "B", "blanks": 0, "options": ["使用平板接单", "冒充派单给的资料接单", "不开麦试音"]}, {"id": 45, "bank": "J", "sort": 23, "stem": "属于抢老板违规行为：私加老板、____。", "qtype": "fill", "answer": "私聊老板", "blanks": 1, "options": []}, {"id": 46, "bank": "J", "sort": 24, "stem": "区分清理人员和自退人员的入团规则。", "qtype": "short", "answer": "被清理人员不可二次入团，清理人员必须删掉好友，不删同样会被清理；自退人员可以二次入团", "blanks": 0, "options": []}], "assistants": []}